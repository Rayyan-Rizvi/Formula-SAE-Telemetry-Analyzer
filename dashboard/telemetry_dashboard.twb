    <worksheet name='Vehicle Health'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Vehicle Health - Temperature Rise by Session</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lap_summary' name='federated.0jawxul1xvew5s1domsxf13s8kbm' />
          </datasources>
          <datasource-dependencies datasource='federated.0jawxul1xvew5s1domsxf13s8kbm'>
            <column caption='Temp Rise Over Ambient' datatype='real' name='[Calculation_6394737903411202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([peak_temp_c]) - MIN([ambient_temp_c])' />
            </column>
            <column caption='Ambient Temp C' datatype='real' name='[ambient_temp_c]' role='measure' type='quantitative' />
            <column-instance column='[seeded_fault]' derivation='None' name='[none:seeded_fault:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_id]' derivation='None' name='[none:session_id:nk]' pivot='key' type='nominal' />
            <column caption='Peak Temp C' datatype='real' name='[peak_temp_c]' role='measure' type='quantitative' />
